{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-return": "off",
    "no-underscore-dangle": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/generated/*", "@prisma/*"],
            "message": "Prisma tylko w src/server/."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["src/routeTree.gen.ts", "src/generated/**", ".output/**"],
  "overrides": [
    {
      "files": ["src/server/**", "prisma.config.ts", "scripts/**", "tests/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "@prisma/*",
                  "@/generated/*",
                  "@/server/*",
                  "@tanstack/*"
                ],
                "message": "domain/ to czysta logika: bez Reacta, Prismy i serwera."
              }
            ]
          }
        ]
      }
    }
  ]
}
