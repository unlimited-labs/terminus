{
  "name": "zapisy-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "postinstall": "prisma generate",
    "seed-admin": "node --env-file-if-exists=.env scripts/seed-admin.ts",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.ts",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "oxlint --type-aware && oxfmt --check && tsc --noEmit && fallow && react-doctor --no-telemetry && vitest run"
  },
  "dependencies": {
