{
  "name": "terminus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "postinstall": "prisma generate",
    "seed-admin": "node --env-file-if-exists=.env scripts/seed-admin.ts",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.ts",
    "reset-2fa": "node --env-file-if-exists=.env scripts/reset-2fa.ts",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "oxlint --type-aware && oxfmt --check && tsc --noEmit && fallow && react-doctor --no-telemetry && vitest run && vite build --logLevel error",
    "e2e": "playwright test",
    "release": "node scripts/release.ts",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait",
    "db:down": "docker compose -f compose.dev.yaml down"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "1.7.18",
    "@better-auth/prisma-adapter": "1.7.18",
    "@date-fns/tz": "1.5.0",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@fontsource-variable/figtree": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "consola": "3.4.2",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.69.0",
    "nodemailer": "10.3.1",
    "papaparse": "5.7.0",
    "prisma": "7.10.1",
    "qrcode.react": "4.2.0",
    "rate-limiter-flexible": "11.2.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@better-auth/utils": "0.5.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fallow": "3.39.0",
    "mailparser": "3.14.2",
    "nitro": "3.0.261103-rc",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "react-doctor": "0.9.22",
    "shadcn": "4.23.0",
    "smtp-server": "3.21.3",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.8.1"
}
